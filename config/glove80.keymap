        layer_basic {
            bindings = <
         &kp C_BRI_DN  &kp C_BRI_UP  &kp C_PP  &kp C_PREV  &kp C_NEXT                                                                                               &kp C_VOL_DN  &kp C_VOL_UP  &kp K_MUTE  &to LAYER_unix  &to LAYER_windows
